{
    "$schema": "vendor/infection/infection/resources/schema.json",
    "source": {
        "directories": ["src"]
    },
    "logs": {
        "text": "php://stderr",
        "summary": "build/infection-summary.log"
    },
    "testFramework": "testo",
    // The PHPStan extension classes are plumbing their mutants cannot
    // reach from a unit test — the decisions they delegate to (matcher
    // kinds, closure shape, cardinality) are what this number is about.
    // Set at introduction (2026-08-25).
    "minMsi": 85,
    "mutators": {
        "@default": true
    }
}
